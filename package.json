    "check-sync": "node scripts/check-sync.mjs"
  },
  "dependencies": {
    "hono": "4.13.18",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@cloudflare/workers-types": "5.20261112.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
